# Copy to .env for local use only. Never commit .env.

TRADING_BOT_ENV=local
TRADING_MODE=backtest
ALLOW_LIVE_TRADING=false
ALLOW_PAPER_TRADING=false
ALLOW_SHORTING=false
ALLOW_LEVERAGE=false

# Keep broker/exchange credentials out of Git.
# Use a secret manager for anything beyond local paper testing.
# BROKER_API_KEY=
# BROKER_API_SECRET=
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=

# Optional local paths
DATA_DIR=./data
REPORTS_DIR=./reports
LOGS_DIR=./logs
MODELS_DIR=./models
