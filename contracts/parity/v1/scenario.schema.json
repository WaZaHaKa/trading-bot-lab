{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trading-bot-lab/parity/v1/scenario.schema.json",
  "additionalProperties": false,
  "properties": {
    "assumptions": {"type": "object"},
    "expected": {"type": "object"},
    "fixture": {"type": "string"},
    "fixture_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "risk": {"type": "object"},
    "scenario_id": {"minLength": 1, "type": "string"},
    "scenario_manifest_version": {"const": "1.0.0"},
    "strategy": {"type": "object"},
    "symbol": {"minLength": 1, "type": "string"},
    "timeframe_seconds": {"minimum": 1, "type": "integer"}
  },
  "required": [
    "scenario_manifest_version",
    "scenario_id",
    "fixture",
    "fixture_sha256",
    "symbol",
    "timeframe_seconds",
    "strategy",
    "assumptions",
    "risk",
    "expected"
  ],
  "title": "Trading Bot Lab parity scenario v1",
  "type": "object"
}
